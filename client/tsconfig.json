{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"types": ["node", "svelte", "vite/client"]
	},
	"include": ["./**/*.ts", "./**/*.svelte", "../src/tree.ts"],
	"exclude": ["dist"]
}
