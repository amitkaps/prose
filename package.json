{
	"name": "@amitkaps/prose",
	"version": "0.1.0",
	"description": "Standard web source files, a light prose convention in their comments, and a dev route that shows the codebase as a navigable, annotatable document.",
	"homepage": "https://prose.amitkaps.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amitkaps/prose.git"
	},
	"files": [
		"dist",
		"client/dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepack": "pnpm run build",
		"build": "vp pack && vp build --config client/vite.config.ts && node scripts/check-client-bundle.mjs",
		"dev": "vp pack --watch",
		"dev:prose": "vp dev --config vite.prose.config.ts",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"check": "vp check && svelte-check --workspace client --tsconfig ./tsconfig.json",
		"test": "vp test --run"
	},
	"dependencies": {
		"@devframes/vite": "^1.0.0",
		"@shikijs/langs": "^1.24.0",
		"@shikijs/themes": "^1.24.0",
		"devframe": "^1.0.0",
		"markdown-exit": "^1.3.0",
		"oxc-parser": "^0.151.0",
		"shiki": "^1.24.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.0.0",
		"fast-check": "^4.10.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plus": "1.0.0-rc.0"
	},
	"peerDependencies": {
		"vite": "^8 || ^1.0.0-rc.0"
	},
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@12.6.0"
}
