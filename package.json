{
  "name": "@amitkaps/prose",
  "version": "0.11.0",
  "description": "prose — the why, beside the code.",
  "homepage": "https://prose.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/prose.git"
  },
  "bin": {
    "prose": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check && pnpm craftz check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "axe": "pnpm run build && node tests/axe.ts",
    "keyboard": "pnpm run build && node tests/keyboard.ts",
    "prose": "node dist/cli.js",
    "verify": "vp run --log grouped all",
    "ship": "craftz deploy",
    "pr": "craftz pr",
    "gone": "craftz gone",
    "craftz": "craftz"
  },
  "devDependencies": {
    "@amitkaps/craftz": "0.13.0",
    "@amitkaps/markz": "0.9.0",
    "@types/node": "26.6.5",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "publint": "0.3.25",
    "vite-plus": "1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
