{
  "name": "@amitkaps/prose",
  "version": "0.2.0",
  "description": "A convention for writing human-oriented meaning into source code (@prose), and a read-only renderer that opens a repository as a Markdown-first document.",
  "homepage": "https://prose.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/prose.git"
  },
  "bin": {
    "prose": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test --run"
  },
  "dependencies": {
    "@amitkaps/markz": "^0.1.1",
    "oxc-parser": "^0.151.0",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vite-plus": "1.0.0-rc.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0"
}
