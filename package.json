{
  "name": "@amitkaps/prose",
  "version": "0.8.0",
  "description": "prose — the why, beside the code.",
  "homepage": "https://prose.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/prose.git"
  },
  "bin": {
    "prose": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "axe": "pnpm run build && node tests/axe.ts",
    "keyboard": "pnpm run build && node tests/keyboard.ts",
    "prose": "node dist/cli.js",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm prose check && pnpm prose build && vp build",
    "ship": "cf deploy --prebuilt",
    "pr": "node scripts/pr.ts",
    "gone": "node scripts/gone.ts"
  },
  "devDependencies": {
    "@amitkaps/markz": "0.6.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "cf": "1.0.0-beta.18",
    "playwright-core": "^1.64.1",
    "publint": "^0.3.25",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.13.0"
}
