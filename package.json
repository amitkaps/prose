{
	"name": "@amitkaps/prose",
	"version": "0.0.1",
	"description": "Standard web source files, a light prose convention in their comments, and a dev route that shows the codebase as a navigable, annotatable document.",
	"license": "MIT",
	"files": [
		"dist",
		"client"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown && vite build --config vite.client.config.ts && node scripts/check-client-bundle.mjs",
		"dev": "tsdown --watch",
		"dev:prose": "vite dev --config vite.prose.config.ts",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"check": "vp check",
		"test": "vp test --run"
	},
	"dependencies": {
		"@devframes/vite": "^1.0.0",
		"@shikijs/langs": "^1.24.0",
		"@shikijs/themes": "^1.24.0",
		"devframe": "^1.0.0",
		"markdown-exit": "^1.3.0",
		"shiki": "^1.24.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-plus": "1.0.0-rc.0"
	},
	"peerDependencies": {
		"vite": "^5 || ^6 || ^7 || ^8"
	},
	"packageManager": "pnpm@12.6.0"
}
